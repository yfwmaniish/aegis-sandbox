# ─── Aegis Sandbox configuration ───────────────────────────────────────────
# Copy to .env and adjust. Never commit the real .env (TR-SEC: secrets in vault).

# --- API / control plane ---
AEGIS_ENV=dev
AEGIS_API_HOST=0.0.0.0
AEGIS_API_PORT=8000
AEGIS_JWT_SECRET=change-me-to-a-long-random-string
AEGIS_JWT_ALG=HS256
AEGIS_JWT_TTL_MINUTES=60

# --- PostgreSQL (metadata) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
# SQLAlchemy URL is derived from the above in core/config.py

# --- Redis (Celery broker + result backend) ---
REDIS_URL=redis://redis:6379/0

# --- MinIO / S3 (samples, artifacts, pcaps — quarantine bucket) ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=aegis
S3_SECRET_KEY=aegis-secret
S3_BUCKET_SAMPLES=aegis-samples
S3_BUCKET_ARTIFACTS=aegis-artifacts

# --- OpenSearch (normalized event indexing/search) ---
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin

# --- Qdrant (embeddings / similarity search) ---
QDRANT_URL=http://qdrant:6333

# --- Static analysis limits ---
STATIC_MAX_FILE_MB=200
STATIC_STRING_MIN_LEN=5
STATIC_STRING_MAX_COUNT=50000
